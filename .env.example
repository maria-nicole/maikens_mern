# ---------------------------------------------------------------------------
# Maikens — backend environment
#
# Copy this file to ".env" in the repository ROOT:
#     cp .env.example .env
#
# The backend reads the root ".env" (see backend/config/env.js), not one inside
# backend/. The real .env is gitignored — never commit it.
# ---------------------------------------------------------------------------


# === Required ==============================================================
# The server exits immediately if it can't reach MongoDB.
# Local: mongodb://127.0.0.1:27017/maikens
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/maikens
MONGO_URI=

# Signs the 30-day login tokens. Use a long random string.
JWT_SECRET=


# === Needed for a feature ==================================================
# Google sign-in. The frontend needs the same value as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Verification emails (6-digit codes on sign-up), sent through Brevo.
# Create a key at https://app.brevo.com/settings/keys.
# Leave it blank and the shop still works, but accounts are not verified by email.
BREVO_API_KEY=

# AI design generation and virtual try-on.
GEMINI_API_KEY=


# === Optional — the app still runs without these ===========================
# Image uploads. Without all three, uploads are written to backend/uploads on
# local disk, which is fine in development but wiped on every redeploy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Where verification and welcome emails come from. MAIL_FROM_EMAIL is the address
# they are sent from, and it has to be a sender you have verified in Brevo
# (Senders -> Add a sender -> Brevo emails you a 6-digit code). A personal address
# such as your own Gmail works, and is what this project uses - it needs no domain.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Maikens Gown & Barong

# Pin a specific Gemini image model, e.g. gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=

# Rate limits, per hour. Defaults: 10 and 6.
GEMINI_MAX_PER_HOUR=10
TRYON_MAX_PER_HOUR=6


# === Server ================================================================
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins. In production this must
# match the deployed frontend exactly, or every request is blocked by CORS.
CORS_ORIGIN=http://localhost:5173

# Base URL used for links inside emails.
CLIENT_URL=http://localhost:5173
