# ---------------------------------------------------------------------------
# Maikens — frontend environment (Vite)
#
# Copy this file to "frontend/.env".
#
# Only variables prefixed with VITE_ are exposed to the browser, so anything
# you put here is public. Never put an API key or secret in this file.
# ---------------------------------------------------------------------------


# Where the API lives. Optional in development (the app falls back to
# http://localhost:5000), but a production build without it will point at
# localhost and fail.
VITE_API_URL=http://localhost:5000

# Google OAuth client id. Must be the same client the backend uses.
VITE_GOOGLE_CLIENT_ID=
